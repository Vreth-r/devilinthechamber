<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Deals/DealMenu.uss?fileID=7433441132597879392&amp;guid=23d4675c23f720744b96bce3472655a1&amp;type=3#DealMenu" />
    <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.54); justify-content: center; align-items: center; align-content: center; width: 100%; padding-top: 40px; padding-right: 40px; padding-bottom: 40px; padding-left: 40px; align-self: auto; height: 100%;">
        <ui:VisualElement name="Panel" style="flex-grow: 0; width: 100%; background-color: rgba(0, 0, 0, 0.36); justify-content: space-evenly; align-items: center; align-self: center; height: 100%; flex-direction: column; align-content: stretch; min-width: auto; color: rgba(255, 0, 0, 0); background-size: 100% 100%;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-self: stretch; justify-content: space-around; align-items: center; padding-right: 0; padding-left: 0; padding-top: 0; padding-bottom: 0; align-content: auto;">
                <ui:Button text="Deal 1" name="Deal1" selectable="false" focusable="false" tooltip="you" double-click-selects-word="false" triple-click-selects-line="false" class="expandable Card DealNotSelected" />
                <ui:Button text="Deal 2" name="Deal2" selectable="false" focusable="false" tooltip="are" double-click-selects-word="false" triple-click-selects-line="false" class="expandable Card DealNotSelected" />
                <ui:Button text="Deal 3" name="Deal3" selectable="false" focusable="false" tooltip="gay" enabled="true" double-click-selects-word="false" triple-click-selects-line="false" class="expandable Card DealNotSelected" />
            </ui:VisualElement>
            <ui:Button text="Choose Deal" name="ChooseButton" enabled="false" class="DealTitle" style="background-color: rgb(56, 40, 40); -unity-background-image-tint-color: rgb(255, 255, 255); border-left-color: rgb(156, 117, 14); border-right-color: rgb(156, 117, 14); border-top-color: rgb(156, 117, 14); border-bottom-color: rgb(156, 117, 14); font-size: 28%;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
