<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Deals/DealMenu.uss?fileID=7433441132597879392&amp;guid=23d4675c23f720744b96bce3472655a1&amp;type=3#DealMenu" />
    <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.54); justify-content: center; align-items: center; align-content: center; width: 100%; padding-top: 40px; padding-right: 40px; padding-bottom: 40px; padding-left: 40px; align-self: auto; height: 100%;">
        <ui:VisualElement name="Panel" style="flex-grow: 0; width: 108%; background-color: rgba(0, 0, 0, 0.36); justify-content: space-evenly; align-items: center; align-self: center; height: 100%; flex-direction: column; align-content: flex-start; min-width: auto; color: rgba(255, 0, 0, 0);">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-self: stretch; justify-content: space-between; align-items: center; padding-right: 50px; padding-left: 50px;">
                <ui:Button text="Deal 1" name="Deal1" selectable="true" focusable="true" tooltip="you" class="expandable Card DealNotSelected" />
                <ui:Button text="Deal 2" name="Deal2" selectable="true" focusable="true" tooltip="are" class="expandable Card DealNotSelected" />
                <ui:Button text="Deal 3" name="Deal3" selectable="true" focusable="true" tooltip="gay" enabled="true" class="expandable Card DealNotSelected" />
            </ui:VisualElement>
            <ui:Button text="Choose Deal" name="ChooseButton" enabled="false" class="DealTitle" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/IMFellDoublePica-Regular.ttf?fileID=12800000&amp;guid=60d52b811ed8b934bb3e8612482c3f26&amp;type=3#IMFellDoublePica-Regular&quot;); background-color: rgb(56, 40, 40); -unity-background-image-tint-color: rgb(255, 255, 255); font-size: 24px; border-left-color: rgb(156, 117, 14); border-right-color: rgb(156, 117, 14); border-top-color: rgb(156, 117, 14); border-bottom-color: rgb(156, 117, 14);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
