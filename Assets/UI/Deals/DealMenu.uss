.expandable {
    width: 25%;
    height: 75%;
    transition: scale 0.3s ease;
    transition-timing-function: linear;
}

.expandable:hover {
    scale: 1.1 1.1;
}

.BuffTitle {
    color: rgb(206, 180, 78);
    -unity-text-align: middle-left;
    font-size: 30px;
    letter-spacing: 5px;
    -unity-font-definition: url("project://database/Assets/Fonts/IMFellDoublePica-Regular.ttf?fileID=12800000&guid=60d52b811ed8b934bb3e8612482c3f26&type=3#IMFellDoublePica-Regular");
    translate: 0 20px;
    white-space: normal;
}

.DebuffTitle {
    color: rgb(255, 0, 0);
    -unity-text-align: middle-left;
    font-size: 30px;
    letter-spacing: 5px;
    -unity-font-definition: url("project://database/Assets/Fonts/IMFellDoublePica-Regular.ttf?fileID=12800000&guid=60d52b811ed8b934bb3e8612482c3f26&type=3#IMFellDoublePica-Regular");
    translate: 0 20px;
    transform-origin: center;
    background-size: 100% 100%;
    white-space: normal;
}

.DealDescription {
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Fonts/IMFellDoublePica-Regular.ttf?fileID=12800000&guid=60d52b811ed8b934bb3e8612482c3f26&type=3#IMFellDoublePica-Regular");
    color: rgb(148, 148, 148);
    -unity-text-align: middle-left;
    white-space: normal;
}

.CardTextBox {
    flex-grow: 1;
    -unity-font-definition: url("project://database/Assets/Fonts/IMFellDoublePica-Regular.ttf?fileID=12800000&guid=60d52b811ed8b934bb3e8612482c3f26&type=3#IMFellDoublePica-Regular");
    color: rgb(206, 180, 78);
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    -unity-text-align: upper-left;
    transform-origin: center;
}

.DealTitle {
    align-self: center;
    -unity-font-style: bold;
    font-size: 32px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: rgb(206, 180, 78);
    -unity-font-definition: url("project://database/Assets/Fonts/IMFellDoublePica-Regular.ttf?fileID=12800000&guid=60d52b811ed8b934bb3e8612482c3f26&type=3#IMFellDoublePica-Regular");
}

.DealSelected {
    border-left-color: rgb(255, 171, 0);
    border-right-color: rgb(255, 171, 0);
    border-top-color: rgb(255, 171, 0);
    border-bottom-color: rgb(255, 171, 0);
}

.DealNotSelected {
    background-image: url("project://database/Assets/UI/Assets/CardFront.png?fileID=2800000&guid=197acad7887379a41a7bc6b54ce48a47&type=3#CardFront");
    background-size: 250% 100%;
    background-color: rgba(188, 188, 188, 0);
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
}

.Card {
    background-image: url("project://database/Assets/UI/Assets/CardFront.png?fileID=2800000&guid=197acad7887379a41a7bc6b54ce48a47&type=3#CardFront");
    background-size: 250% 100%;
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
