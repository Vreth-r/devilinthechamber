            <ui:VisualElement name="one-eye-panel" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px; flex-direction: column-reverse; justify-content: flex-start; align-items: stretch;">
