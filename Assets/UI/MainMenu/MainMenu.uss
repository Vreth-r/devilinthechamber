.button {
    width: 35%;
    height: 15%;
    -unity-font-definition: url("project://database/Assets/Fonts/SpecialElite-Regular.ttf?fileID=12800000&guid=56966513ffd5dd249a39927fc40602ae&type=3#SpecialElite-Regular");
    font-size: 260%;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 25px;
    color: rgb(213, 22, 22);
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 1px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    align-self: center;
    transition-property: scale;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.button:hover {
    scale: 1.1;
}

.button:active {
    scale: 0.95;
}

.hover {
    scale: 1.1;
}

.active {
    scale: 0.95;
}
