<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PauseMenu/PauseMenu.uss?fileID=7433441132597879392&amp;guid=b34d64a391b49f048b4b62e2e8454286&amp;type=3#PauseMenu" />
    <ui:VisualElement name="Background" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0.35); justify-content: center; align-items: stretch; align-content: flex-start; width: 100%; flex-shrink: 0; flex-direction: row; height: 100%;">
        <ui:VisualElement name="Left" style="flex-grow: 1; width: 50%; height: 100%; align-content: center; align-self: auto; align-items: stretch; justify-content: space-around;">
            <ui:VisualElement name="Picture" style="flex-grow: 0; width: 60%; height: 80%; align-self: center; align-content: flex-start; align-items: flex-end; top: auto; background-image: url(&quot;project://database/Assets/UI/Assets/googa.PNG?fileID=2800000&amp;guid=3f5bf927549fbcd48a7ee6ad6ca4e880&amp;type=3#googa&quot;);" />
        </ui:VisualElement>
        <ui:VisualElement name="Right" style="flex-grow: 1; width: 50%; height: 100%; justify-content: space-around;">
            <ui:VisualElement name="Panel" style="flex-grow: 0.5; width: 25%; background-color: rgba(0, 0, 0, 0.39); justify-content: center; align-items: center; align-self: center; height: auto; -unity-font-definition: url(&quot;project://database/Assets/Fonts/RubikGlitch-Regular.ttf?fileID=12800000&amp;guid=118a412dcec70dc48a18b40ee0a4f5d3&amp;type=3#RubikGlitch-Regular&quot;);">
                <ui:Button text="Resume" name="Resume" class="button" style="width: 212px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:VisualElement style="flex-grow: 0; height: 10%;" />
                <ui:Button text="Exit" name="Exit" class="button" style="width: 212px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
